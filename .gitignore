# Python
.venv/
__pycache__/
*.pyc

# Node
node_modules/
package-lock.json

# Third-party model binaries (1.4 GB). Fetch instructions in README.md.
models/*.gguf
models/*.onnx
# openWakeWord's pre-trained models (CC BY-NC-SA 4.0): fetched by
# scripts/fetch-models.py, never committed to the public copy.
web/models/hey_jarvis_v0.1.onnx
web/models/melspectrogram.onnx
web/models/embedding_model.onnx

# Pinned onnxruntime-web 1.18 wasm (~20 MB). Fetch instructions in README.md.
web/ort18/*.wasm
web/ort18/*.js

# Vendored IBM Plex latin subset (~75 KB). web/ may not fetch a font at
# runtime, so these are on disk: python -X utf8 scripts/fetch-fonts.py
web/fonts/*.woff2

# Vendored xterm.js (in-page terminal, CT-4): python -X utf8 scripts/fetch-xterm.py
web/vendor/

# TLS key material. Never commit a private key.
ssl/

# Runtime state, logs, transcripts
state/
*.log

# Scratch working directory: where a harness child runs when harness_cwd is
# blank (AC-31). Created on demand by butlerd.harness_spec_resolver.
TMP/

# Design imports. The comp that web/index.html was transcribed from, plus its
# React runtime and screenshots -- 1.4 MB of source material that no build
# consumes. web/AGENTS.md records what was taken from it and what was not.
/ui/

# Probe output. test/manual/page.png is the canonical shot the probe writes and
# is tracked; ad-hoc extras and the bench's raw dump are regenerated, not kept.
test/manual/page-*.png
test/bench_tts_results.json

# CKB code-intelligence index. Generated by `ckb index`, machine-local,
# 1.5 MB and regenerated from source -- never a review artifact.
.ckb/
index.scip

# Local daemon config: real engines/backends for the live daemon. Its
# absence is the all-fakes default a fresh clone and the test suite rely on
# (BUTLER_CONFIG isolates tests from a present one). Machine-specific, like
# state/ and models/.
config/models.json

# Local zvec-grep (zg) semantic search index. 26 MB of machine-local
# vectors rebuilt in 5 s; never shared.
.zvec-grep/

# Agent scratch: mock screenshots, regenerable, never worth 2.4 MB of history.
.shots/

# playwright-cli session artefacts (page snapshots, local config)
.playwright-cli/
.playwright/

# Cloned third-party repos for prior-art analysis (.references/*.md are tracked)
.references/repos/

# Tauri desktop app (app/): Rust build output and tauri-build generated schemas.
app/src-tauri/target/
app/src-tauri/gen/

# Pinned Pocket TTS binary: python -X utf8 scripts/fetch-pocket-tts.py
vendor/
